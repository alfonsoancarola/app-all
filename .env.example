# .env.example — Plantilla para configurar credenciales del daily report.
#
# Copiá este archivo a `.env` (que NO se commitea — está en .gitignore) y
# completá los valores reales.
#
#   cp .env.example .env
#   nano .env

# Cuenta Gmail desde la que se manda el report.
SMTP_USER=tu.email@gmail.com

# App password de Gmail (16 caracteres, sin espacios). NO uses tu password
# normal de Gmail — generá un app password aparte:
#   1. Ir a https://myaccount.google.com/security
#   2. Activar "2-Step Verification" si no está activo.
#   3. En la misma página, entrar a "App passwords".
#   4. Generar uno con nombre "App All Daily Report".
#   5. Pegar acá los 16 caracteres SIN espacios.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Servidor SMTP (default: Gmail). Cambiar solo si usás otro proveedor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Destinatarios del report — separados por coma, sin espacios extra.
# Empezá solo con vos para validar el formato; después sumás gente.
REPORT_RECIPIENTS=tu.email@gmail.com

# Asunto del email (se le pega la fecha automático al final).
REPORT_SUBJECT=Daily Report · FS / Exports / Pizarra
